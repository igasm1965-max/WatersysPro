PORT=3000
MQTT_BROKER=mqtt://m1.wqtt.ru:19160
MQTT_TOPIC_BASE=watersystem
DEMO_FALLBACK_ENABLED=false
REMOTE_REQUIRE_TOKEN=true
REMOTE_ADMIN_TOKEN=change_me_strong_token
JWT_SECRET=replace_with_random_secret_string_here
# Public self-registration is DISABLED by default (production). Enable only for staging.
ALLOW_REGISTRATION=false
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=watersys
PGPORT=5432

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-domain.com

# ─── Уведомления об авариях (Telegram + SMS) ─────────────────────────────────
TG_BOT_TOKEN=<CHANGE_ME>
TG_CHAT_ID=
SMS_PROVIDER=none
SMS_PHONE=
SMS_FROM=WATERSYS
SMSAERO_EMAIL=
SMSAERO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MAX (мессенджер через WQTT MQTT-мост)
WQTT_TOKEN=
WQTT_TOPIC=maxmsg
WQTT_HOST=dash.wqtt.ru
NOTIFY_REPEAT_MIN=10
NOTIFY_REPEAT_MAX=5
