# MQTT broker used by backend
MQTT_BROKER=mqtt://m1.wqtt.ru:19160
MQTT_TOPIC_BASE=watersystem

# Disable demo fallback to show only real telemetry devices
DEMO_FALLBACK_ENABLED=false

# Postgres connection
PGHOST=postgres
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=watersys

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
PGPORT=5432

# Server port
PORT=3000

# Remote web control protection
# If REMOTE_REQUIRE_TOKEN=true, remote API requires header x-admin-token
REMOTE_REQUIRE_TOKEN=true
REMOTE_ADMIN_TOKEN=change_me_strong_token

# Public self-registration (/api/auth/register) — DISABLED by default in production.
# Enable only for trusted/staging environments.
ALLOW_REGISTRATION=false

# Expo push (optional)
EXPO_ACCESS_TOKEN=

# ─── MAX (мессенджер через WQTT MQTT-мост) ────────────────────────────────────
# Дополнительный канал оповещения. Отправка в чат MAX идёт через публикацию
# сообщения в MQTT-топик моста платформы WQTT (dash.wqtt.ru REST API).
# Токен WQTT (выдаётся в dash.wqtt.ru; заголовок Authorization: Token <token>).
WQTT_TOKEN=
# Топик(и) моста, в которые публиковать сообщение (для доставки в чат MAX).
# Несколько топиков — через запятую. Пример: maxmsg
WQTT_TOPIC=maxmsg
# Хост REST API WQTT (по умолчанию dash.wqtt.ru)
WQTT_HOST=dash.wqtt.ru

# ─── Уведомления об авариях (Telegram + SMS) ─────────────────────────────────
# Основной канал — Telegram. Бот работает через long-polling (исходящие запросы),
# поэтому подходит и для облака, и для локального сервера без публичного URL.

# Токен Telegram-бота (создаётся через @BotFather в Telegram).
# Пример: 123456789:AAH...xyz
TG_BOT_TOKEN=

# ID чата, куда отправлять уведомления.
# Если оставить пустым — backend автоматически определит его из первого сообщения,
# которое пользователь отправит боту (нужно написать боту /start один раз).
TG_CHAT_ID=

# Резервный канал — SMS. Провайдер: none | smsaero | twilio
SMS_PROVIDER=none
# Телефон получателя в международном формате, напр. 79001234567
SMS_PHONE=
# Подпись SMS (SMS Aero)
SMS_FROM=WATERSYS

# SMS Aero (https://smsaero.ru)
SMSAERO_EMAIL=
SMSAERO_API_KEY=

# Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Эскалация: повторное уведомление, если авария не сброшена
NOTIFY_REPEAT_MIN=10    # интервал повторного уведомления (минут)
NOTIFY_REPEAT_MAX=5     # максимум повторных уведомлений за одну аварию
